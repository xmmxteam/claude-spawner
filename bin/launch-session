#!/usr/bin/env bash
# launch-session <project> [--name N] [--mode default|bypass] [--worktree] [--docker-host dind|desktop|tcp://host:port]
source /opt/launcher/lib/lib.sh

[[ $# -ge 1 ]] || die "usage: launch-session <project> [--name N] [--mode default|bypass] [--worktree] [--docker-host dind|desktop|tcp://host:port]"
project=$1; shift
name=; mode=bypass; worktree=; dh=
while (( $# )); do
  case $1 in
    --name) name=${2:?}; shift 2 ;;
    --mode) mode=${2:?}; shift 2 ;;
    --worktree) worktree=1; shift ;;
    --docker-host) dh=${2:?}; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

[[ $mode == default || $mode == bypass ]] || die "mode must be default or bypass"

if [[ $project == /* ]]; then dir=$(realpath -m "$project"); else dir=$(realpath -m "$WORKSPACE/$project"); fi
[[ $dir == "$WORKSPACE"/* && -d $dir ]] || die "not a directory inside $WORKSPACE: $project"

case $dh in
  "") dh_url= ;;
  dind) dh_url=tcp://dind:2375 ;;
  desktop) dh_url=${DESKTOP_DOCKER_HOST:?DESKTOP_DOCKER_HOST is not set} ;;
  tcp://*) [[ $dh =~ ^tcp://[A-Za-z0-9._-]+:[0-9]+$ ]] || die "bad docker host: $dh"; dh_url=$dh ;;
  *) die "bad --docker-host: $dh" ;;
esac

[[ -n $name ]] || name=$(basename "$dir")
valid_name "$name" || die "invalid session name: $name"
if [[ -f $(reg_file "$name") ]]; then
  if is_live "$name"; then die "session '$name' is already running; pass --name to start another"; fi
  ( reg_load "$name"; [[ $STATUS != running ]] ) || die "session '$name' is registered as running; use resume-session"
fi

NAME=$name DIR=$dir MODE=$mode DOCKER_HOST_ARG=$dh_url STATUS=running STARTED_ONCE=0
WORKTREE=; [[ -n $worktree ]] && WORKTREE=$name
SID=$(cat /proc/sys/kernel/random/uuid)
reg_save
start_session "$name"
echo "started '$name' in ${dir#"$WORKSPACE"/} (mode=$mode${worktree:+, worktree}${dh_url:+, docker=$dh_url})"
