#!/usr/bin/env bash
# Container entrypoint: seeds config, starts tmux and ttyd, waits for a Claude login,
# starts the launcher, resumes sessions that were running, then keeps the launcher alive.
source /opt/launcher/lib/lib.sh

log() { echo "[entrypoint] $*"; }

mkdir -p "$HOME/.claude"
# Merge the seed over any existing user settings (seed keys win).
user_settings=$HOME/.claude/settings.json
[[ -s $user_settings ]] || echo '{}' > "$user_settings"
jq -s '.[0] * .[1]' "$user_settings" /opt/launcher/config/user-settings.json > "$user_settings.tmp"
mv "$user_settings.tmp" "$user_settings"
cp /opt/launcher/config/container-CLAUDE.md "$HOME/.claude/CLAUDE.md"

# Hindsight memory: config comes from secrets/, the plugin (hooks, MCP server, skill) is installed once.
if [[ -f /secrets/hindsight-coding-agent.json ]]; then
  mkdir -p "$HOME/.hindsight"
  # install, not cp: the secret is mounted read-only (0444), and cp would copy that mode and then
  # fail to overwrite the file on the next boot. The file holds an API token, so keep it private.
  install -m 0600 /secrets/hindsight-coding-agent.json "$HOME/.hindsight/coding-agent.json"
  if ! grep -q 'hindsight' "$HOME/.claude/settings.json"; then
    log "installing Hindsight coding-agent plugin"
    npx -y @vectorize-io/hindsight-coding-agents install claude-code --server self-hosted \
      --api-url "$(jq -r '.apiUrl // empty' "$HOME/.hindsight/coding-agent.json")" \
      || log "Hindsight install failed; sessions will run without memory"
  fi
fi

# Codex plugin for Claude Code (installed once; plugin state lives on the home volume).
# The Codex login itself is interactive: run `codex login --device-auth` in the ttyd terminal.
if ! grep -qs 'codex@openai-codex' "$HOME/.claude/plugins/installed_plugins.json"; then
  log "installing the Codex plugin"
  { claude plugin marketplace add openai/codex-plugin-cc && claude plugin install codex@openai-codex; } \
    || log "Codex plugin install failed"
fi

if [[ -n ${GIT_USER_NAME:-} ]]; then git config --global user.name "$GIT_USER_NAME"; fi
if [[ -n ${GIT_USER_EMAIL:-} ]]; then git config --global user.email "$GIT_USER_EMAIL"; fi

# Default Docker over SSH: an optional key and known_hosts from secrets/ get an ssh config entry
# derived from DEFAULT_DOCKER_HOST. Without the key, the container's existing SSH setup is used.
# Called as "setup_docker_ssh || ...", where errexit is off, so each step checks itself.
setup_docker_ssh() {
  rm -f "$HOME/.ssh/docker.conf"
  [[ ${DEFAULT_DOCKER_HOST:-} == ssh://* && -f /secrets/docker-ssh-key ]] || return 0
  log "configuring SSH for the default Docker host"
  local rest=${DEFAULT_DOCKER_HOST#ssh://} user= port=
  rest=${rest%%/*}
  if [[ $rest == *@* ]]; then user=${rest%%@*}; rest=${rest#*@}; fi
  if [[ $rest == *:* ]]; then port=${rest##*:}; rest=${rest%:*}; fi
  install -d -m 0700 "$HOME/.ssh" || return 1
  install -m 0600 /secrets/docker-ssh-key "$HOME/.ssh/docker-ssh-key" || return 1
  {
    echo "Host $rest"
    if [[ -n $user ]]; then echo "  User $user"; fi
    if [[ -n $port ]]; then echo "  Port $port"; fi
    echo "  IdentityFile ~/.ssh/docker-ssh-key"
    echo "  IdentitiesOnly yes"
    echo "  BatchMode yes"
    if [[ -f /secrets/docker-known-hosts ]]; then
      install -m 0600 /secrets/docker-known-hosts "$HOME/.ssh/docker-known-hosts" || return 1
      echo "  UserKnownHostsFile ~/.ssh/docker-known-hosts"
      echo "  StrictHostKeyChecking yes"
    else
      echo "  StrictHostKeyChecking accept-new"
    fi
  } > "$HOME/.ssh/docker.conf" || return 1
  # Include must come before any Host block to apply to it.
  if ! grep -qs 'docker.conf' "$HOME/.ssh/config"; then
    { echo "Include ~/.ssh/docker.conf"; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$HOME/.ssh/config.tmp" || return 1
    install -m 0600 "$HOME/.ssh/config.tmp" "$HOME/.ssh/config" || return 1
    rm -f "$HOME/.ssh/config.tmp"
  fi
}
setup_docker_ssh || log "SSH setup for the default Docker host failed; sessions may need to use dind"

if [[ -n ${GH_TOKEN:-} ]]; then gh auth setup-git || true; fi
if [[ -n ${FORGEJO_HOST:-} && -n ${FORGEJO_TOKEN:-} ]]; then
  git config --global "credential.https://${FORGEJO_HOST}.helper" \
    '!f() { echo "username=${FORGEJO_USER}"; echo "password=${FORGEJO_TOKEN}"; }; f'
fi

tm start-server \; set -g exit-empty off
ttyd -p 7681 -W bash -l &

trap 'log "terminating"; exit 0' TERM INT

logged_in() { [[ -s $HOME/.claude/.credentials.json ]]; }

while true; do
  if ! logged_in; then
    log "not logged in: open the ttyd page (port 7681) and run 'claude' then /login"
  elif ! is_live launcher; then
    log "starting launcher"
    tm new-session -d -s launcher -c "$WORKSPACE" start-launcher
    resume-session --all-running || true
  fi
  if logged_in && ! is_live workspace; then
    log "starting workspace device"
    tm new-session -d -s workspace -c "$WORKSPACE" start-workspace
  fi
  sleep 30 &
  wait $!
done
