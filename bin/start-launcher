#!/usr/bin/env bash
# Runs inside the "launcher" tmux session. The launcher is restricted by --tools Bash (the only
# control with no settings equivalent) plus a root-owned settings file whose dontAsk mode denies
# every command not on the allowlist. Managed settings are not used because they would also
# restrict the project sessions.
#
# Like project sessions, the launcher resumes its conversation after a container restart, and
# starts a new one after a normal /exit or when the image version changes.
source /opt/launcher/lib/lib.sh

state_file=$STATE/launcher.env
SID= STATUS= LAUNCHED_VERSION=
# shellcheck disable=SC1090
[[ -f $state_file ]] && source "$state_file"
version=${SPAWNER_VERSION:-dev}

save_state() {
  { printf 'SID=%q\n' "$SID"; printf 'STATUS=%q\n' "$STATUS"; printf 'LAUNCHED_VERSION=%q\n' "$LAUNCHED_VERSION"; } > "$state_file.tmp"
  mv "$state_file.tmp" "$state_file"
}

shutting=0
trap 'shutting=1' HUP TERM

# Resume only when a transcript exists and the image is the same version. A resumed session keeps
# the system prompt it started with and ignores the new --append-system-prompt, so a new image
# needs a new session to pick up prompt and build information changes.
if [[ $STATUS == running && -n $SID && $LAUNCHED_VERSION == "$version" ]] && compgen -G "$HOME/.claude/projects/*/$SID.jsonl" >/dev/null; then
  args=(--resume "$SID")
else
  SID=$(cat /proc/sys/kernel/random/uuid)
  args=(--session-id "$SID" --model haiku) # alias: always the latest Haiku
fi
STATUS=running LAUNCHED_VERSION=$version
save_state

cd "$WORKSPACE" || exit 1

set +e
claude "${args[@]}" --remote-control "Claude Spawner" \
  --tools Bash \
  --settings /opt/launcher/config/launcher-settings.json \
  --strict-mcp-config \
  --append-system-prompt "$(cat /opt/launcher/config/launcher-prompt.md /opt/launcher/version.txt)"
set -e

if (( shutting )); then
  echo "interrupted by shutdown; will resume on next boot"
  exit 0
fi
STATUS=finished
save_state
