# Copy to .env (git-ignored) and fill in.
GH_TOKEN=
FORGEJO_HOST=git.xmmx.dev
FORGEJO_USER=
FORGEJO_TOKEN=
# Hosts the launcher's clone-repo tool may clone from (space separated).
ALLOWED_GIT_HOSTS=github.com git.xmmx.dev
# Remote Docker host on the desktop PC, selectable per session with --docker-host desktop.
DESKTOP_DOCKER_HOST=tcp://10.0.0.1:2375
