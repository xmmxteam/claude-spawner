# Copy to .env (git-ignored) and fill in.
GH_TOKEN=
FORGEJO_HOST=
FORGEJO_USER=
FORGEJO_TOKEN=
# Hosts the launcher's clone-repo tool may clone from (space separated).
ALLOWED_GIT_HOSTS=github.com git.mydomain.home
# Remote Docker host on the desktop PC, selectable per session with --docker-host desktop.
DESKTOP_DOCKER_HOST=tcp://192.168.0.1:2375
VAULT_ADDR=
# Container timezone (tz database name) and locale (en_AU gives day/month/year dates).
TZ=Australia/Brisbane
LANG=en_AU.UTF-8
