# Copy to .env (git-ignored) and fill in.

GH_TOKEN=
FORGEJO_HOST=
FORGEJO_USER=
FORGEJO_TOKEN=
VAULT_ADDR=

# Hosts the launcher's clone-repo tool may clone from (space separated).
ALLOWED_GIT_HOSTS=github.com git.mydomain.home

# Default Docker host over SSH, as ssh://user@host[:port]. Leave empty to use the local dind
# sidecar. Optional secrets/docker-ssh-key and secrets/docker-known-hosts are installed into ~/.ssh
# on boot; without them the container's existing SSH setup is used.
DEFAULT_DOCKER_HOST=

# Author name and email for commits made in the container.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Container timezone (tz database name) and locale (en_AU gives day/month/year dates).
TZ=Australia/Brisbane
LANG=en_AU.UTF-8
